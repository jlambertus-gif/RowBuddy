{
    "name": "rowbuddy/transfers",
    "description": "Transfers bounded context: seller-to-buyer handoff confirmation, QR issuance/validation, and the payment-capture trigger for a won auction (Phase 5).",
    "type": "library",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../shared-kernel",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "rowbuddy/shared-kernel": "@dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "RowBuddy\\Transfers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RowBuddy\\Transfers\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "stan": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
