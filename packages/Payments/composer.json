{
    "name": "rowbuddy/payments",
    "description": "Payments bounded context: PaymentIntent authorization, fee calculation, and payout preparation for a won auction (Phase 4).",
    "type": "library",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../shared-kernel",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "rowbuddy/shared-kernel": "@dev",
        "stripe/stripe-php": "^21.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "RowBuddy\\Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RowBuddy\\Payments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "stan": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
