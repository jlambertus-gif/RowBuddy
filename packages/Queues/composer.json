{
    "name": "rowbuddy/queues",
    "description": "Queues bounded context: queue definitions, the pending/approved/published/rejected authorship lifecycle (ADR-005), and jurisdiction/restricted-category gating.",
    "type": "library",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../shared-kernel",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "rowbuddy/shared-kernel": "@dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "RowBuddy\\Queues\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RowBuddy\\Queues\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "stan": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
