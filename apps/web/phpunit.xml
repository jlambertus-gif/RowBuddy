<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Every setting below is duplicated as both <env> (force="true")
            and <server>, and both duplications are load-bearing:

            docker-compose.yml's `env_file: apps/web/.env` sets
            APP_ENV/DB_CONNECTION/SESSION_DRIVER/etc. as real container
            environment variables. PHP populates BOTH getenv()/$_ENV and
            $_SERVER from that at process start. PHPUnit's <env> (even
            with force="true") only overrides putenv()/$_ENV — it never
            touches $_SERVER — while Laravel's Env repository checks
            $_SERVER first. Without the matching <server> entries here
            (which PHPUnit always applies unconditionally), $_SERVER keeps
            the container's real values, Laravel keeps reading
            APP_ENV=local / DB_CONNECTION=pgsql, tests silently run
            against the real dev Postgres database instead of in-memory
            sqlite, and RefreshDatabase's migrate:fresh wipes it on every
            run.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!--
            A non-empty placeholder for all three (Phase 9, ADR-027
            Sprint 3) — Stripe's own SDK validates the API key format
            eagerly at StripeClient construction time, so any test that
            merely resolves a Stripe-touching service from the container
            (e.g. a real AuctionWon dispatch reaching
            TriggerAuctionWinAuthorization) throws before ever reaching a
            test's own assertions unless something is configured. None of
            these three values is a real credential, and none is shaped
            like one — deliberately not prefixed "sk_test_"/"pk_test_"/
            "whsec_", the real prefixes Stripe itself issues, so it can
            never be mistaken for or misused as a real Stripe credential.
            Real Stripe test-mode integration tests detect the absence of
            a genuine "sk_test_"-prefixed secret and skip themselves
            explicitly rather than attempting a real network call against
            this placeholder.
        -->
        <env name="STRIPE_KEY" value="phpunit_placeholder_publishable_key_not_real" force="true"/>
        <env name="STRIPE_SECRET" value="phpunit_placeholder_secret_key_not_real" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="phpunit_placeholder_webhook_secret_not_real" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
        <server name="STRIPE_KEY" value="phpunit_placeholder_publishable_key_not_real"/>
        <server name="STRIPE_SECRET" value="phpunit_placeholder_secret_key_not_real"/>
        <server name="STRIPE_WEBHOOK_SECRET" value="phpunit_placeholder_webhook_secret_not_real"/>
    </php>
</phpunit>
