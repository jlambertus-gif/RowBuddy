# Copy to .env to override the local docker-compose defaults baked into
# src/api/client.ts and src/lib/realtime.ts. All EXPO_PUBLIC_* vars are
# inlined into the JS bundle at build time (Expo's own convention) — never
# put a real secret in one of these; REVERB_APP_KEY is the Pusher-protocol
# "app key," a public identifier already exposed to web browsers via the
# web app's own VITE_REVERB_APP_KEY, never the app *secret*.

# Android emulators cannot resolve "localhost" as the host machine —
# override both of these to 10.0.2.2 there. iOS simulators and physical
# devices on the same network as the backend can usually keep the default.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_REVERB_APP_KEY=43vsggynk3jze2sohqfq
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
